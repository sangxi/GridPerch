# Auto detect text files and perform LF normalization
* text=auto

# 校验和清单必须保持 LF：Windows 工作区若被转成 CRLF，
# Linux/CI 上 `sha256sum -c` 会把文件名末尾的 \r 当成文件名的一部分而校验失败。
SHA256SUMS.txt text eol=lf

# 部署脚本同理：CRLF 的 shell 脚本在 Linux 上会报 $'\r': command not found
*.sh text eol=lf
*.service text eol=lf
*.env.example text eol=lf

# 源码与内嵌资源也强制 LF。
# 仓库里 core.autocrlf=true 时，`* text=auto` 会让 Windows 工作区把检出过的文件
# 转成 CRLF（索引仍然是 LF），于是：
#   ① `gofmt -l` 会点名一长串其实没改过的文件，干扰「格式化三连」自检；
#   ② 前端资源是 go:embed 进二进制的，CRLF 版会和 LF 版产生不同的产物哈希。
# 这里逐类锁死，改完两边一致。
*.go text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
# go.mod / go.sum 同样锁 LF：Windows 下被转成 CRLF 会让 `go mod tidy` 改写整个文件，
# 也会把无关行尾抖动混进提交。
*.mod text eol=lf
*.sum text eol=lf

# Dockerfile 没有扩展名，`* text=auto` 管不到。
# 一旦被检出成 CRLF，`RUN xxx \` 的续行符后面会多一个 \r，构建直接报
# 「unable to process line continuation」。
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf

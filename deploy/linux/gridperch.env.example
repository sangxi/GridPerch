# GridPerch 监控端配置示例
# 复制到 /etc/gridperch/gridperch.env 后按需修改，权限保持 600。
#
# 注意：本程序读取环境变量时「空串等同于没设置」——留空会回落到默认值。
# 想关闭某项功能要用启动参数（例如完全离线用 -hub=），不要靠把变量设空。

# ---- 监听与存储 ----
GRIDPERCH_ADDR=:9999
GRIDPERCH_DB=/opt/gridperch/data/gridperch.db
GRIDPERCH_RETENTION=30

# ---- 控制台账号 ----
GRIDPERCH_ADMIN_USER=admin
GRIDPERCH_ADMIN_PASS=改成一段强密码

# ---- 采集端通信密钥（必须与采集端 -token 一致）----
GRIDPERCH_TOKEN=改成一段强密钥

# ---- 对外访问地址（反向代理 / 一键安装脚本 / 更新下载会用到）----
GRIDPERCH_PUBLIC_URL=http://10.0.0.5:9999

# ---- 授权与在线更新（一般不用改）----
# 授权中心地址默认已内置在程序里，无需填写；仅当使用自建授权中心时才取消注释并填地址
# GRIDPERCH_HUB=
# GRIDPERCH_HUB_INTERVAL_MIN=5
# GRIDPERCH_HUB_AUTO_UPDATE=download
# 多网卡/容器场景机器码会漂移时，用下面这行把机器码钉死（值从控制台「授权购买」页复制）
# GRIDPERCH_LICENSE_MACHINE=

# ---- 可调性能参数（大集群再动）----
# GRIDPERCH_READ_CONNS=8
# GRIDPERCH_WRITE_QUEUE=8192
# GRIDPERCH_PROBE_WORKERS=64

# ---- 告警阈值 ----
# GRIDPERCH_CPU_ALERT=90
# GRIDPERCH_MEM_ALERT=90
# GRIDPERCH_DISK_ALERT=90
# GRIDPERCH_LOAD_ALERT=10
# GRIDPERCH_ALERT_COOLDOWN_MIN=10
# GRIDPERCH_LOGIN_ALERT=true

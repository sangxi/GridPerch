# Strix 监控端 · Docker 环境变量
# 复制成 .env 后按需修改：cp .env.example .env
#
# 注意：程序对「空串」的处理等同于「没设置」，会回落到默认值。
# 要关闭某项功能请用启动参数（如完全离线用 -hub=），不要靠把变量设空。

# ---- 控制台账号（务必修改）----
STRIX_ADMIN_USER=admin
STRIX_ADMIN_PASS=改成一段强密码

# ---- 采集端通信密钥（必须与采集端的 -token 一致，务必修改）----
STRIX_TOKEN=改成一段强密钥

# ---- 对外访问地址：填宿主机能被其它机器访问到的地址 ----
STRIX_PUBLIC_URL=http://10.0.0.5:9999

# ---- 【重要】容器里的机器码固定值 ----
# 容器重建后主机名/网卡会变，机器码跟着变，授权就会失效。
# 先起一次容器，在控制台「系统 → 授权购买」页看到机器码，把它填到这里钉死。
# 留空则每次按容器当前信息重新计算。
STRIX_LICENSE_MACHINE=

# ---- 授权与在线更新（一般不用改）----
# 授权中心地址默认已内置在程序里，无需填写；仅当使用自建授权中心时才取消注释并填地址
# STRIX_HUB=
# STRIX_HUB_INTERVAL_MIN=5
# STRIX_HUB_AUTO_UPDATE=download

# ---- 数据保留与性能（大集群再动）----
# STRIX_RETENTION=30
# STRIX_READ_CONNS=8
# STRIX_WRITE_QUEUE=8192
# STRIX_PROBE_WORKERS=64
